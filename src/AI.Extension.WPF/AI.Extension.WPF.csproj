<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>AI.Extension.WPF</RootNamespace>
    <Description>AI Extension 的 WPF 外壳：聊天面板、工具调用可视化、UI 线程调度实现、MCP 对外暴露（HTTP / stdio）。</Description>
    <IsPackable>true</IsPackable>
    <PackageId>Karl.AIExtension.WPF</PackageId>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MdXaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI.Extension.Core\AI.Extension.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Demo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- stdio Bridge：随包分发，并通过 buildTransitive target 自动复制到输出目录 -->
    <None Include="..\AI.Extension.Mcp.StdioBridge\bin\$(Configuration)\net48\AiMcpStdioBridge.exe"
          Pack="true"
          PackagePath="tools/net48"
          Visible="false" />
    <None Include="buildTransitive\Karl.AIExtension.WPF.targets"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
  </ItemGroup>

</Project>
