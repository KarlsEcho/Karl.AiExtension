<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AI.Extension.WPF</RootNamespace>
    <Description>AI Extension 的 WPF 外壳：聊天面板、工具调用可视化、UI 线程调度实现、同进程对外暴露 MCP（Streamable HTTP）。</Description>
    <IsPackable>true</IsPackable>
    <PackageId>AI.Extension.WPF</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI.Extension.Core\AI.Extension.Core.csproj" />
  </ItemGroup>

</Project>
