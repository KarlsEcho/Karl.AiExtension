<UserControl x:Class="AI.Extension.WPF.Diagnostics.AiDiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:AI.Extension.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="440"
             Background="#FFFFFF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
        <DataTemplate x:Key="ContractTemplate">
            <Border Margin="0,3" Padding="10,8" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding MethodCount, StringFormat={}{0} 个方法}"
                                   FontSize="10"
                                   Foreground="#64748B" />
                        <TextBlock Text="{Binding ContractName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                    </DockPanel>
                    <TextBlock Text="{Binding ContractFullName}"
                               FontSize="10"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MethodList}"
                               FontSize="11"
                               Foreground="#334155"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToolTemplate">
            <Border Margin="0,3" Padding="10,8" CornerRadius="8" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#0C4A6E" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="11"
                               Foreground="#334155"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActivityTemplate">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Timestamp, StringFormat=\{0:HH:mm:ss\}}"
                           FontFamily="Consolas"
                           FontSize="10"
                           Foreground="#94A3B8"
                           Margin="0,0,8,0" />
                <TextBlock Text="{Binding Description}"
                           FontSize="11"
                           Foreground="#334155"
                           TextWrapping="Wrap" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="刷新"
                        Command="{Binding RefreshCommand}"
                        Padding="10,4"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        BorderThickness="0"
                        Cursor="Hand" />
                <StackPanel>
                    <TextBlock Text="工具与契约"
                               Foreground="#FFFFFF"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="源生成器产出的契约桥接 vs MCP Server 实际暴露的工具"
                               Foreground="#94A3B8"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander Header="AI 契约（源生成器）" IsExpanded="True" FontSize="12" Foreground="#334155" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding Contracts}"
                                  ItemTemplate="{StaticResource ContractTemplate}" />
                </Expander>

                <Expander Header="MCP 工具（微软 MCP C# SDK 暴露）" IsExpanded="True" FontSize="12" Foreground="#334155" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding Tools}"
                                  ItemTemplate="{StaticResource ToolTemplate}" />
                </Expander>

                <Expander Header="对外暴露 MCP（Streamable HTTP，仅本机）" IsExpanded="True" FontSize="12" Foreground="#334155" Margin="0,0,0,8">
                    <Border Padding="10,8" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="默认关闭。开启后，本机其他 AI harness（Claude Code / WorkBuddy 等）可通过 URL 使用同一套 MCP 工具；不需要再单独启动 Demo.Host。"
                                       FontSize="11"
                                       Foreground="#92400E"
                                       TextWrapping="Wrap" />

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="端口"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#334155" />
                                <TextBox Text="{Binding ExposurePortText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditExposurePort}"
                                         Width="72"
                                         Margin="6,0,0,0"
                                         Padding="4,2"
                                         VerticalContentAlignment="Center" />
                                <Button Content="{Binding ExposureButtonText}"
                                        Command="{Binding ToggleExposureCommand}"
                                        Margin="8,0,0,0"
                                        Padding="12,4"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Cursor="Hand" />
                            </DockPanel>

                            <TextBlock Text="{Binding ExposureStatusText}"
                                       FontSize="11"
                                       Foreground="#92400E"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBox Text="{Binding ExposureUrl, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Foreground="#0C4A6E"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsTabStop="False"
                                     HorizontalScrollBarVisibility="Auto"
                                     Visibility="{Binding ExposureUrl, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Header="UI 上下文日志（环形缓冲，AI 唤醒时读取）" IsExpanded="True" FontSize="12" Foreground="#334155">
                    <ItemsControl ItemsSource="{Binding Activities}"
                                  ItemTemplate="{StaticResource ActivityTemplate}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

