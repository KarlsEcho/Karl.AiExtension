<UserControl x:Class="AI.Extension.WPF.Providers.AiProviderManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="460"
             Background="#FFFFFF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel>

        <!-- 顶部：当前模型 -->
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="14,10">
            <StackPanel>
                <TextBlock Text="模型与供应商" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" />
                <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                    <Run Text="当前模型：" />
                    <Run Text="{Binding ActiveModelText, Mode=OneWay}" Foreground="#93C5FD" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 底部：状态 + 忙碌指示 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,8" Background="#FFFFFF">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right"
                             Width="80"
                             Height="4"
                             IsIndeterminate="True"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="#475569"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：供应商列表 -->
            <DockPanel Grid.Column="0" Background="#F8FAFC">
                <Button DockPanel.Dock="Top"
                        Content="+ 新增供应商"
                        Command="{Binding AddCommand}"
                        Margin="10,10,10,6"
                        Padding="8,5"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        BorderThickness="0"
                        Cursor="Hand" />
                <ListBox ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                         Margin="6,0,6,6"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding ActiveBadge}"
                                               FontSize="10"
                                               Foreground="#059669"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 右：编辑区 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12" DataContext="{Binding SelectedProvider}">
                    <TextBlock Text="供应商配置" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />

                    <TextBlock Text="Id（不可修改）" FontSize="10" Foreground="#64748B" Margin="0,8,0,2" />
                    <TextBox Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" Padding="6,4" Background="#F1F5F9" />

                    <TextBlock Text="显示名" FontSize="10" Foreground="#64748B" Margin="0,8,0,2" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />

                    <TextBlock Text="Endpoint（OpenAI 兼容，例如 https://api.deepseek.com/v1）" FontSize="10" Foreground="#64748B" Margin="0,8,0,2" TextWrapping="Wrap" />
                    <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />

                    <TextBlock Text="API Key（落盘时用 Windows DPAPI 加密）" FontSize="10" Foreground="#64748B" Margin="0,8,0,2" />
                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />

                    <CheckBox Content="启用该供应商"
                              IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,10,0,0"
                              FontSize="12" />

                    <TextBlock Text="模型列表（每行一个；支持「模型Id|显示名」）" FontSize="10" Foreground="#64748B" Margin="0,10,0,2" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ModelsText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Height="96"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="11"
                             Padding="6,4" />

                    <TextBlock Text="默认模型 Id" FontSize="10" Foreground="#64748B" Margin="0,8,0,2" />
                    <TextBox Text="{Binding DefaultModelId, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />

                    <TextBlock Text="{Binding Notes}"
                               FontSize="10"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="保存"
                                Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="14,6"
                                Margin="0,0,8,8"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="测试连接"
                                Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="14,6"
                                Margin="0,0,8,8"
                                Background="#0F766E"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="拉取模型"
                                Command="{Binding DataContext.DiscoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="14,6"
                                Margin="0,0,8,8"
                                Background="#334155"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="设为当前模型"
                                Command="{Binding DataContext.SetActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="14,6"
                                Margin="0,0,8,8"
                                Background="#7C3AED"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="清除当前模型"
                                Command="{Binding DataContext.ClearActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="14,6"
                                Margin="0,0,8,8"
                                Background="#475569"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="删除"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="14,6"
                                Margin="0,0,8,8"
                                Background="#B91C1C"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
