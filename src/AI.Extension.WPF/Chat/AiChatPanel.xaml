<UserControl x:Class="AI.Extension.WPF.Chat.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:chat="clr-namespace:AI.Extension.WPF.Chat"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="440"
             Background="#FFFFFF">

    <UserControl.Resources>
        <DataTemplate x:Key="TabHeaderTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MaxWidth="120"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="双击重命名会话">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding BeginEditTitleCommand}" />
                    </TextBlock.InputBindings>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBox Grid.Column="0"
                         Text="{Binding EditingTitle, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="12"
                         Width="120"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="TitleEditBox_PreviewKeyDown"
                         Loaded="TitleEditBox_Loaded">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Column="1"
                        Content="×"
                        Margin="6,0,0,0"
                        Padding="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        ToolTip="关闭会话（记录保留，可在「打开会话」下拉里重新打开）" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TabContentTemplate">
            <chat:ChatConversationView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 会话操作栏 -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="重命名"
                            Command="{Binding SelectedTab.BeginEditTitleCommand}"
                            Padding="10,4"
                            Background="#F1F5F9"
                            BorderThickness="0"
                            FontSize="11"
                            Cursor="Hand"
                            ToolTip="重命名当前会话（也可以双击标签标题）" />
                    <Button Content="归档当前"
                            Command="{Binding ArchiveSelectedCommand}"
                            Padding="10,4"
                            Background="#F1F5F9"
                            BorderThickness="0"
                            FontSize="11"
                            Cursor="Hand"
                            ToolTip="移入 store.json（已归档），不再出现在会话标签里" />
                    <Button Content="删除当前"
                            Command="{Binding DeleteSelectedCommand}"
                            Margin="6,0,0,0"
                            Padding="10,4"
                            Background="#FEE2E2"
                            Foreground="#991B1B"
                            BorderThickness="0"
                            FontSize="11"
                            Cursor="Hand"
                            ToolTip="永久删除会话记录" />
                </StackPanel>

                <Button Content="+ 新建会话"
                        Command="{Binding NewConversationCommand}"
                        Padding="10,4"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand" />

                <ComboBox x:Name="OpenableBox"
                          Width="150"
                          Margin="8,0,0,0"
                          ItemsSource="{Binding OpenableConversations}"
                          SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                          DisplayMemberPath="DisplayTitle"
                          IsEditable="False"
                          VerticalContentAlignment="Center"
                          FontSize="11"
                          ToolTip="重新打开已关闭的会话（已归档会话选中后会自动取消归档）" />

                <TextBlock Text="{Binding StatusText}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#64748B"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 会话标签页 -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    ItemTemplate="{StaticResource TabHeaderTemplate}"
                    ContentTemplate="{StaticResource TabContentTemplate}"
                    BorderThickness="0"
                    Background="#FFFFFF" />
    </Grid>
</UserControl>
