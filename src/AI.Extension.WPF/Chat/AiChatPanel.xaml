<UserControl x:Class="AI.Extension.WPF.Chat.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:chat="clr-namespace:AI.Extension.WPF.Chat"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="440"
             Background="#FFFFFF">

    <UserControl.Resources>
        <DataTemplate x:Key="TabHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MaxWidth="120"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
                <Button Content="×"
                        Margin="6,0,0,0"
                        Padding="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        ToolTip="关闭会话（记录保留，下次启动可恢复）" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TabContentTemplate">
            <chat:ChatConversationView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 会话操作栏 -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="归档当前"
                            Command="{Binding ArchiveSelectedCommand}"
                            Padding="10,4"
                            Background="#F1F5F9"
                            BorderThickness="0"
                            FontSize="11"
                            Cursor="Hand"
                            ToolTip="移入 store.json（已归档），不再出现在会话标签里" />
                    <Button Content="删除当前"
                            Command="{Binding DeleteSelectedCommand}"
                            Margin="6,0,0,0"
                            Padding="10,4"
                            Background="#FEE2E2"
                            Foreground="#991B1B"
                            BorderThickness="0"
                            FontSize="11"
                            Cursor="Hand"
                            ToolTip="永久删除会话记录" />
                </StackPanel>

                <Button Content="+ 新建会话"
                        Command="{Binding NewConversationCommand}"
                        Padding="10,4"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand" />

                <TextBlock Text="{Binding StatusText}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#64748B"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 会话标签页 -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    ItemTemplate="{StaticResource TabHeaderTemplate}"
                    ContentTemplate="{StaticResource TabContentTemplate}"
                    BorderThickness="0"
                    Background="#FFFFFF" />
    </Grid>
</UserControl>
