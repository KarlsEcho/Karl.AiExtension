<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AI.Extension</RootNamespace>
    <Description>AI Extension 契约层：AI 契约标注特性、桥接基类、UI 上下文追踪与 DI 基础设施。</Description>
    <IsPackable>true</IsPackable>
    <PackageId>AI.Extension.Abstractions</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI.Extension.Abstractions.Generator\AI.Extension.Abstractions.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!--
    真实产品形态下，本包会把 SourceGenerator 打进 analyzers/dotnet/cs，
    引用 AI.Extension.Abstractions 的项目即自动获得生成器。
    源码树里 Roslyn 分析器不随 ProjectReference 传递，
    因此消费方（Demo.MCP）额外显式引用了 Generator 项目作为 Analyzer。
  -->
  <ItemGroup>
    <None Include="..\AI.Extension.Abstractions.Generator\bin\$(Configuration)\netstandard2.0\AI.Extension.Abstractions.Generator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
