<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Demo.MCP</RootNamespace>
    <Description>Demo 的 MCP 层：主动依赖契约层，声明 [AiContractBinding]，承载生成器产出的桥接基础设施与手写的 [McpServerTool] 语义封装。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- 依赖方向：MCP 层 -> 契约层（MCP 主动依赖契约，契约对 AI 无感知） -->
    <ProjectReference Include="..\Demo.Contract\Demo.Contract.csproj" />
    <ProjectReference Include="..\..\src\AI.Extension.Abstractions\AI.Extension.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 源码树中分析器不随 ProjectReference 传递，这里显式引入；打 NuGet 包后由 Abstractions 的 analyzers 目录自动提供 -->
    <ProjectReference Include="..\..\src\AI.Extension.Abstractions.Generator\AI.Extension.Abstractions.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

