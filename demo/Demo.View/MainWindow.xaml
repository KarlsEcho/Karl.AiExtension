<Window x:Class="Demo.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:chat="clr-namespace:AI.Extension.WPF.Chat;assembly=AI.Extension.WPF"
        xmlns:diag="clr-namespace:AI.Extension.WPF.Diagnostics;assembly=AI.Extension.WPF"
        xmlns:providers="clr-namespace:AI.Extension.WPF.Providers;assembly=AI.Extension.WPF"
        xmlns:ui="clr-namespace:AI.Extension.WPF.Ui;assembly=AI.Extension.WPF"
        mc:Ignorable="d"
        Title="Karl.AiExtension · 契约驱动 + MCP 的桌面端 AI 扩展 Demo"
        Height="880"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="720" />
            <ColumnDefinition Width="470" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：传统业务界面（人类操作路径） -->
        <DockPanel Grid.Column="0">

            <Border DockPanel.Dock="Top" Background="#0F172A" Padding="18,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="刷新"
                                Command="{Binding RefreshCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0"
                                Background="#1E293B"
                                Foreground="#E2E8F0"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="取消选中订单"
                                Command="{Binding CancelSelectedCommand}"
                                Padding="14,6"
                                Background="#B91C1C"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="订单管理"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="人类走 UI，Agent 走 MCP —— 两条路径复用同一套 ViewModel 与业务逻辑"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10" Background="#FFFFFF">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="选中行会把内容带入编辑区；新增时直接填写后点「新增订单」"
                                   FontSize="10"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="新增 / 编辑订单"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                    </DockPanel>

                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <TextBlock Text="客户" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="130"
                                 Padding="6,4"
                                 Text="{Binding EditCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,12,6" />

                        <TextBlock Text="金额" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="90"
                                 Padding="6,4"
                                 Text="{Binding EditAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,12,6" />

                        <TextBlock Text="备注" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="190"
                                 Padding="6,4"
                                 Text="{Binding EditRemark, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,12,6" />

                        <Button Content="新增订单"
                                Command="{Binding CreateOrderCommand}"
                                Padding="12,5"
                                Margin="0,0,8,6"
                                Background="#059669"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="保存到选中"
                                Command="{Binding UpdateSelectedOrderCommand}"
                                Padding="12,5"
                                Margin="0,0,8,6"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="删除选中"
                                Command="{Binding DeleteSelectedOrderCommand}"
                                Padding="12,5"
                                Margin="0,0,8,6"
                                Background="#B91C1C"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="重置"
                                Command="{Binding ClearEditorCommand}"
                                Padding="12,5"
                                Margin="0,0,8,6"
                                Background="#64748B"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8" Background="#FFFFFF">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right"
                                 Width="90"
                                 Height="4"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#475569"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEF2F7"
                      RowHeight="36"
                      FontSize="13"
                      BorderThickness="0"
                      Background="#FFFFFF"
                      AlternatingRowBackground="#FBFDFF"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="订单号" Binding="{Binding Id}" Width="110" />
                    <DataGridTextColumn Header="客户" Binding="{Binding CustomerName}" Width="130" />
                    <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="110" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd\}}" Width="120" />
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 右栏：AI 外壳（Agent 操作路径），来自 AI.Extension.WPF -->
        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Background="#FFFFFF">
            <TabControl BorderThickness="0" Background="#FFFFFF">
                <TabItem Header="AI 对话" FontSize="12">
                    <ui:AiChatHost x:Name="ChatSurface" />
                </TabItem>
                <TabItem Header="模型与供应商" FontSize="12">
                    <ui:AiProviderManagerHost x:Name="ProvidersSurface" />
                </TabItem>
                <TabItem Header="工具与契约" FontSize="12">
                    <ui:AiDiagnosticsHost x:Name="DiagnosticsSurface" />
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>

