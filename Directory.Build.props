<Project>

  <PropertyGroup>
    <!-- 默认目标框架；WPF/Blazor/生成器等项目在自身 csproj 中覆盖 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!-- NuGet 包元数据（demo/tests 通过 IsPackable=false 排除） -->
    <Version>0.1.0-beta.1</Version>
    <Company>Karl</Company>
    <Product>Karl.AiExtension</Product>
    <Authors>Karl</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/KarlsEcho/Karl.AiExtension</RepositoryUrl>
    <PackageProjectUrl>https://github.com/KarlsEcho/Karl.AiExtension</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ai;mcp;wpf;blazor;source-generator;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- demo / tests 不参与打包 -->
  <PropertyGroup>
    <IsPackable Condition="$(MSBuildProjectName.StartsWith('Demo'))">false</IsPackable>
    <IsPackable Condition="$(MSBuildProjectName.EndsWith('.Tests'))">false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
